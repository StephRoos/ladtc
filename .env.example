# Database (PostgreSQL — self-hosted via Docker or Neon)
DATABASE_URL=postgresql://ladtc:changeme@localhost:5433/ladtc

# BetterAuth
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WordPress API (legacy, optional)
NEXT_PUBLIC_WP_API_URL=https://ladtc.be

# Email (Resend)
RESEND_API_KEY=re_xxx

# Admin contact email
ADMIN_EMAIL=admin@ladtc.be

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Sentry (error tracking, optional)
NEXT_PUBLIC_SENTRY_DSN=

# Docker Compose (used by docker-compose.yml only)
POSTGRES_USER=ladtc
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ladtc
